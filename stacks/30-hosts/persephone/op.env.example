TF_VAR_key_pair_name = "op://<vault>/<item>/key pair name"   # the EC2 key pair the instance was launched with
TF_VAR_login_account_name = "op://<vault>/<item>/login account name"   # the personal login account the first boot creates
TF_VAR_login_account_uid = "op://<vault>/<item>/login account uid"   # its user ID, which owns its home directory on the home volume
TF_VAR_login_account_gid = "op://<vault>/<item>/login account gid"   # its primary group ID, which owns its home directory on the home volume
